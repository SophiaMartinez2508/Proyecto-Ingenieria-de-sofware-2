    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { Product } from \"./types\";\n\nexport const EXCLUSIVE_SHADES = [\n  { id: \"ivory\", name: \"\303\211clat Ivoire\", hex: \"#f5ebe0\", className: \"bg-[#f5ebe0]\" },\n  { id: \"sand\", name: \"Sable Dor\303\251\", hex: \"#e5c9b8\", className: \"bg-[#e5c9b8]\" },\n  { id: \"terracotta\", name: \"Terre Chaude\", hex: \"#b07d62\", className: \"bg-[#b07d62]\" },\n  { id: \"cocoa\", name: \"Moka Royal\", hex: \"#7f5539\", className: \"bg-[#7f5539]\" },\n  { id: \"noir\", name: \"Noir Absolu\", hex: \"#1f1a1b\", className: \"bg-[#1f1a1b]\" },\n];\n\nexport const PRODUCTS: Product[] = [\n  {\n    id: \"eclat-absolu-body\",\n    name: \"Body \303\211clat Absolu\",\n    price: 139,\n    originalPrice: 175,\n    tag: \"Bestseller\",\n    technology: \"Nanomedicina Textil Integrada\",\n    description: \"La joya de la corona de nuestra biotecnolog\303\255a moldeadora. Dise\303\261ado con una capa externa de compresi\303\263n milim\303\251trica y un forro enriquecido con principios activos dermo-cosm\303\251ticos.\",\n    benefits: [\n      \"Microc\303\241psulas de \303\241cido hialur\303\263nico y cafe\303\255na que se activan con la temperatura corporal.\",\n      \"Costuras de seda ultras\303\263nicas completamente invisibles bajo telas ultra ajustadas.\",\n      \"Compresi\303\263n ergon\303\263mica que mejora la postura lumbar de forma natural.\"\n    ],\n    imageUrl: \"https://images.unsplash.com/photo-1594235222953-ee826ac7af53?auto=format&fit=crop&w=600&q=80\",\n    shades: [\n      EXCLUSIVE_SHADES[0], // Ivoire\n      EXCLUSIVE_SHADES[1], // Sable\n      EXCLUSIVE_SHADES[3], // Moka\n      EXCLUSIVE_SHADES[4], // Noir\n    ]\n  },\n  {\n    id: \"corset-biologique\",\n    name: \"Corset Biologique Infini\",\n    price: 159,\n    tag: \"Alta Costura\",\n    technology: \"Biocer\303\241mica T\303\251rmica\",\n    description: \"Un tributo a la corseter\303\255a francesa cl\303\241sica fusionado con ingenier\303\255a m\303\251dica. Esculpe con suavidad y calidez gracias a sus micro-paneles de biocer\303\241mica activa.\",\n    benefits: [\n      \"Fibras que reflejan el calor infrarrojo lejano del propio cuerpo para estimular la circulaci\303\263n.\",\n      \"Varillas de pol\303\255mero con memoria que se adaptan a la silueta sin maltratar ni asfixiar.\",\n      \"Reducci\303\263n visual inmediata de hasta 4 cm de cintura con confort garantizado de 24 horas.\"\n    ],\n    imageUrl: \"https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=600&q=80\",\n    shades: [\n      EXCLUSIVE_SHADES[0], // Ivoire\n      EXCLUSIVE_SHADES[1], // Sable\n      EXCLUSIVE_SHADES[2], // Terre\n      EXCLUSIVE_SHADES[4], // Noir\n    ]\n  },\n  {\n    id: \"cinturilla-sculpt\",\n    name: \"Cinturilla Sculpt-Active 3D\",\n    price: 95,\n    originalPrice: 120,\n    tag: \"Innovaci\303\263n\",\n    technology: \"Tejido Tridimensional Nano-Carbono\",\n    description: \"Escultura intensiva de talle alto con la ligereza de una segunda piel. Creada con hilos de nano-carbono autoventilados para disipar el sudor y concentrar la firmeza.\",\n    benefits: [\n      \"Tejido hidr\303\263fugo con patr\303\263n hexagonal de ultra elasticidad progresiva.\",\n      \"Cierre microm\303\251trico ajustable de tres posiciones para una definici\303\263n personalizada de curva.\",\n      \"Neutraliza olores de manera natural gracias a las propiedades purificantes de los hilos de carbono.\"\n    ],\n    imageUrl: \"https://images.unsplash.com/photo-1582533561751-ef6f6ab93a2e?auto=format&fit=crop&w=600&q=80\",\n    shades: [\n      EXCLUSIVE_SHADES[1], // Sable\n      EXCLUSIVE_SHADES[3], // Moka\n      EXCLUSIVE_SHADES[4], // Noir\n    ]\n  },\n  {\n    id: \"legging-hydra\",\n    name: \"Legging Hydra-\303\211clat 360\",\n    price: 119,\n    tag: \"Novedad\",\n    technology: \"Hidrataci\303\263n Din\303\241mica de Micro-L\303\255pidos\",\n    description: \"Prenda de control y uso exterior de alto impacto, que redefine gl\303\272teos e hidrata profundamente la piel de las piernas con el roce de cada paso.\",\n    benefits: [\n      \"Liberaci\303\263n prolongada de micro-l\303\255pidos que eliminan la sequedad cut\303\241nea durante el d\303\255a.\",\n      \"Efecto \'Push-Up\' bioconstruido patentado sin rellenos artificiales.\",\n      \"Adecuado tanto para uso deportivo de \303\251lite como para elevar conjuntos de diario con gran distinci\303\263n.\"\n    ],\n    imageUrl: \"https://images.unsplash.com/photo-1506152983158-b4a74a01c721?auto=format&fit=crop&w=600&q=80\",\n    shades: [\n      EXCLUSIVE_SHADES[2], // Terre\n      EXCLUSIVE_SHADES[3], // Moka\n      EXCLUSIVE_SHADES[4], // Noir\n    ]\n  }\n];\n\nexport const TESTIMONIALS = [\n  {\n    author: \"Alessandra V.\",\n    role: \"Editora de Moda & Estilista\",\n    text: \"\303\211clat Wear cambi\303\263 mi percepci\303\263n de las prendas moldeadoras. No solo la silueta es deslumbrante, sino que el tacto sedoso y su frescura tecnol\303\263gica la hacen perfecta para acompa\303\261ar vestidos de sat\303\251n sumamente demandantes.\",\n    rating: 5\n  },\n  {\n    author: \"Dr. Elena Thorne\",\n    role: \"Especialista en Medicina Est\303\251tica\",\n    text: \"La incorporaci\303\263n de microc\303\241psulas de \303\241cido hialur\303\263nico en los hilos de compresi\303\263n representa un avance sin precedentes. Mis pacientes reportan una mejora notable en la elasticidad y suavidad cut\303\241nea de inmediato.\",\n    rating: 5\n  },\n  {\n    author: \"Gabriela Espino\",\n    role: \"Cliente VIP \303\211clat Club\",\n    text: \"La asesor\303\255a por WhatsApp para tallas fue sumamente respetuosa y precisa. Mi Body \303\211clat Absolu lleg\303\263 perfumado y me queda exactamente como un guante. La compresi\303\263n de cintura es firme pero 100% respirable.\",\n    rating: 5\n  }\n];\n"
    }
